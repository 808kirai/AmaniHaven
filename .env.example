# copy to .env and fill it in, never commit .env

# production refuses to start with missing secrets
APP_ENV=development
DATABASE_PATH=amanihaven.db
# sw or en, used until the person picks one or writes in one
DEFAULT_LANGUAGE=sw

# privacy
# generate these once, keep them in a secrets manager and back them up, losing them makes all data unreadable
# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_PEPPER=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
RETENTION_DAYS=30

# africa's talking
# set to africastalking to really send sms
SMS_GATEWAY=console
AT_USERNAME=sandbox
AT_API_KEY=
# your shortcode or approved sender name
AT_SENDER_ID=
USSD_CODE=*384*123#
SMS_SHORTCODE=22123
# added to the callback urls as ?key=
WEBHOOK_SECRET=

# triage
# false runs on the rules alone, still safe but less nuanced
LLM_ENABLED=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=20

# people and limits
COUNSELOR_TOKENS=amina:change-me-long-random,brian:change-me-too
COUNSELOR_ALERT_NUMBERS=+2547XXXXXXXX,+2547YYYYYYYY
ADMIN_TOKEN=
MAX_REPLIES_PER_HOUR=20

# helplines for another country, a json list of key, name_en, name_sw, number and free
# HELPLINES_JSON=

# the public /demo page with a pretend phone, only allowed with AT_USERNAME=sandbox
DEMO_ENABLED=false
